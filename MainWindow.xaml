<Window x:Class="TrikiMusicController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource App_Title}"
        Height="820" Width="1060"
        MinHeight="700" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#121318"
        Foreground="#ECEFF1"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1C1E26"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#2A2D3A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Action Card -->
        <Style x:Key="ActionCard" TargetType="Border">
            <Setter Property="Background" Value="#1E202B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,16"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#2B2F40"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Metric Label -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4AE"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Dark ComboBox Item Style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="2,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#37474F"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#263238"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="Background" Value="#2A3442"/>
            <Setter Property="BorderBrush" Value="#3D4D61"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                CornerRadius="6">
                                            <Path x:Name="Arrow"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#90A4AE"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#37474F"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00E5FF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#29434E"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#00E5FF"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="#00E5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="10,0,24,0"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"/>

                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#1A1C24"
                                        BorderBrush="#3D4D61"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        Padding="3"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="220" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter SnapsToDevicePixels="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sensor Bar Style -->
        <Style x:Key="SensorBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#262938"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Status -->
            <RowDefinition Height="*"/>    <!-- Main Tabs -->
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🍺" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Triki Music Controller" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="{DynamicResource App_Subtitle}" FontSize="12" Foreground="#78909C"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status & Battery Info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Status Badge -->
                    <Border x:Name="BadgeConnection" Background="#37474F" CornerRadius="12" Padding="12,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtStatus" Text="{DynamicResource Status_Disconnected}" FontWeight="SemiBold" FontSize="12" Foreground="#ECEFF1"/>
                    </Border>

                    <!-- Battery Badge -->
                    <Border Background="#263238" CornerRadius="12" Padding="12,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔋 " FontSize="12"/>
                            <TextBlock x:Name="TxtBattery" Text="--%" FontWeight="SemiBold" FontSize="12" Foreground="#80CBC4"/>
                        </StackPanel>
                    </Border>

                    <!-- Model Training Status Badge -->
                    <Border x:Name="BadgeModelStatus" Background="#1B5E20" CornerRadius="12" Padding="12,5">
                        <TextBlock x:Name="TxtModelStatus" Text="{DynamicResource Model_Status_Ready}" FontSize="12" Foreground="#C8E6C9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Top Buttons & Language Selector -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector -->
                    <ComboBox x:Name="CmbLanguage" Style="{StaticResource DarkComboBox}"
                              Width="92" Height="34" Margin="0,0,8,0"
                              SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Tag="Ru" Content="🇷🇺 RU"/>
                        <ComboBoxItem Tag="En" Content="🇬🇧 EN"/>
                        <ComboBoxItem Tag="Pl" Content="🇵🇱 PL"/>
                    </ComboBox>

                    <Button x:Name="BtnConnect" Content="{DynamicResource Btn_Connect}" Width="110" Height="34" Margin="0,0,8,0"
                            Background="#00C853" Foreground="#FFFFFF" FontWeight="SemiBold" Click="BtnConnect_Click"
                            BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnMinimizeTray" Content="{DynamicResource Btn_MinimizeTray}" Width="75" Height="34"
                            Background="#263238" Foreground="#ECEFF1" Click="BtnMinimizeTray_Click"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN TABS -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Foreground" Value="#90A4AE"/>
                    <Setter Property="Padding" Value="16,8"/>
                    <Setter Property="Background" Value="#1C1E26"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#00E5FF"/>
                            <Setter Property="Background" Value="#252936"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- TAB 1: LIVE RECOGNITION & CONTROL -->
            <TabItem Header="{DynamicResource Tab_Recognition}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Cards -->
                        <RowDefinition Height="*"/>    <!-- Live Sensor + Settings -->
                        <RowDefinition Height="160"/>  <!-- Log -->
                    </Grid.RowDefinitions>

                    <!-- ACTION CARDS -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Section_LiveRecognition}" FontSize="13" FontWeight="Bold" Foreground="#90A4AE" VerticalAlignment="Center"/>
                                <Border x:Name="BannerHandState" HorizontalAlignment="Right" Background="#37474F" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="TxtHandState" Text="{DynamicResource HandState_Clean}" FontWeight="Bold" FontSize="11" Foreground="#ECEFF1"/>
                                </Border>
                            </Grid>

                            <UniformGrid Columns="5">
                                <!-- PREV -->
                                <Border x:Name="CardPrev" Style="{StaticResource ActionCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏮" FontSize="30" HorizontalAlignment="Center" Foreground="#00E5FF"/>
                                        <TextBlock Text="{DynamicResource Action_Prev}" FontWeight="Bold" FontSize="14" Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtPrevDesc" Text="{DynamicResource Action_Prev_Desc}" FontSize="11" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPrevConf" Text="--%" FontSize="10" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VOL DOWN -->
                                <Border x:Name="CardVolDown" Style="{StaticResource ActionCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔉" FontSize="30" HorizontalAlignment="Center" Foreground="#2979FF"/>
                                        <TextBlock Text="{DynamicResource Action_VolDown}" FontWeight="Bold" FontSize="14" Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtVolDownDesc" Text="{DynamicResource Action_VolDown_Desc}" FontSize="11" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVolDownConf" Text="--%" FontSize="10" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- PLAY / PAUSE -->
                                <Border x:Name="CardPlayPause" Style="{StaticResource ActionCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏯" FontSize="30" HorizontalAlignment="Center" Foreground="#00E676"/>
                                        <TextBlock Text="{DynamicResource Action_PlayPause}" FontWeight="Bold" FontSize="14" Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtPlayDesc" Text="{DynamicResource Action_PlayPause_Desc}" FontSize="11" Foreground="#00E676" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtPlayConf" Text="--%" FontSize="10" Foreground="#81C784" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- VOL UP -->
                                <Border x:Name="CardVolUp" Style="{StaticResource ActionCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🔊" FontSize="30" HorizontalAlignment="Center" Foreground="#2979FF"/>
                                        <TextBlock Text="{DynamicResource Action_VolUp}" FontWeight="Bold" FontSize="14" Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtVolUpDesc" Text="{DynamicResource Action_VolUp_Desc}" FontSize="11" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVolUpConf" Text="--%" FontSize="10" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- NEXT -->
                                <Border x:Name="CardNext" Style="{StaticResource ActionCard}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⏭" FontSize="30" HorizontalAlignment="Center" Foreground="#00E5FF"/>
                                        <TextBlock Text="{DynamicResource Action_Next}" FontWeight="Bold" FontSize="14" Foreground="#ECEFF1" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                        <TextBlock x:Name="TxtNextDesc" Text="{DynamicResource Action_Next_Desc}" FontSize="11" Foreground="#78909C" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtNextConf" Text="--%" FontSize="10" Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- SENSORS & CONTROLS -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SENSORS -->
                        <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Sensors_Title}" FontSize="11" FontWeight="Bold" Foreground="#90A4AE" Margin="0,0,0,8"/>

                                    <!-- SECTION 1: ACCELEROMETER -->
                                    <Border Background="#1C202C" BorderBrush="#2A3142" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🚀" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Sensors_Accel}" FontWeight="Bold" FontSize="11" Foreground="#00E676"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtLiveTotalG" Text="1.00 G" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#00E676"/>
                                            </Grid>

                                            <!-- Total G Bar -->
                                            <ProgressBar x:Name="PbLiveTotalG" Style="{StaticResource SensorBar}" Height="7" Minimum="0" Maximum="5" Foreground="#00E676" Value="1.0" Margin="0,0,0,8"/>

                                            <!-- Accel X -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Accel X" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbAccelX" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-3" Maximum="3" Foreground="#00E676"/>
                                                <TextBlock x:Name="TxtAccelX" Grid.Column="2" Text="0.00 G" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Accel Y -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Accel Y" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbAccelY" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-3" Maximum="3" Foreground="#00E676"/>
                                                <TextBlock x:Name="TxtAccelY" Grid.Column="2" Text="0.00 G" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Accel Z -->
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Accel Z" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbAccelZ" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-3" Maximum="3" Foreground="#00E676"/>
                                                <TextBlock x:Name="TxtAccelZ" Grid.Column="2" Text="1.00 G" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECTION 2: GYROSCOPE -->
                                    <Border Background="#1C202C" BorderBrush="#2A3142" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Sensors_Gyro}" FontWeight="Bold" FontSize="11" Foreground="#00E5FF"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TxtGyroTotal" Text="0 °/s" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12" Foreground="#00E5FF"/>
                                            </Grid>

                                            <!-- Gyro X -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Gyro X" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbGyroX" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-500" Maximum="500" Foreground="#00E5FF"/>
                                                <TextBlock x:Name="TxtGyroX" Grid.Column="2" Text="0.0 °/s" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Gyro Y -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Gyro Y" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbGyroY" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-500" Maximum="500" Foreground="#00E5FF"/>
                                                <TextBlock x:Name="TxtGyroY" Grid.Column="2" Text="0.0 °/s" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <!-- Gyro Z -->
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Gyro Z" Style="{StaticResource MetricLabel}" VerticalAlignment="Center"/>
                                                <ProgressBar x:Name="PbGyroZ" Grid.Column="1" Style="{StaticResource SensorBar}" Minimum="-500" Maximum="500" Foreground="#2979FF"/>
                                                <TextBlock x:Name="TxtGyroZ" Grid.Column="2" Text="0.0 °/s" Style="{StaticResource MetricValue}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- SECTION 3: BUTTON & HARDWARE -->
                                    <Border Background="#1C202C" BorderBrush="#2A3142" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔘" FontSize="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Sensors_Button}" FontSize="11" FontWeight="Bold" Foreground="#ECEFF1" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border x:Name="BadgeBtnState" HorizontalAlignment="Right" Background="#37474F" CornerRadius="4" Padding="8,2">
                                                <TextBlock x:Name="TxtBtnState" Text="{DynamicResource Button_State_Released}" FontSize="10" FontWeight="Bold" Foreground="#ECEFF1"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- MODE CONTROLS -->
                        <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Settings_Title}" FontSize="12" FontWeight="Bold" Foreground="#90A4AE" Margin="0,0,12,12"/>

                                <Border Background="#242735" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings_SendMediaKeys}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{DynamicResource Settings_SendMediaKeys_Desc}" FontSize="11" Foreground="#90A4AE"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkSendMediaKeys" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True"
                                                  Checked="ChkSendMediaKeys_Changed" Unchecked="ChkSendMediaKeys_Changed"/>
                                    </Grid>
                                </Border>

                                <CheckBox x:Name="ChkAutoReconnect" Content="{DynamicResource Settings_AutoReconnect}"
                                          IsChecked="True" Foreground="#B0BEC5" Margin="0,0,0,12" Checked="ChkAutoReconnect_Changed" Unchecked="ChkAutoReconnect_Changed"/>

                                <TextBlock Text="{DynamicResource Settings_Tip_Title}" FontWeight="Bold" Foreground="#FFD600" Margin="0,4,0,4"/>
                                <TextBlock Text="{DynamicResource Settings_Tip_Text}"
                                           Foreground="#B0BEC5" TextWrapping="Wrap" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- LOG -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Log_Title}" FontSize="11" FontWeight="Bold" Foreground="#78909C" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="{DynamicResource Log_OpenFile}" Background="Transparent" Foreground="#00E5FF" BorderThickness="0" Cursor="Hand" Click="BtnOpenLogFile_Click" FontSize="11" Margin="0,0,12,0"/>
                                    <Button Content="{DynamicResource Log_Clear}" Background="Transparent" Foreground="#90A4AE" BorderThickness="0" Cursor="Hand" Click="BtnClearLog_Click" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="GridLog" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#161820" Foreground="#ECEFF1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Log_Col_Time}" Binding="{Binding TimeFormatted}" Width="90"/>
                                    <DataGridTextColumn Header="{DynamicResource Log_Col_Action}" Binding="{Binding Message}" Width="220" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="{DynamicResource Log_Col_Details}" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: GESTURE TRAINING STUDIO -->
            <TabItem x:Name="TabTrainingStudio" Header="{DynamicResource Tab_Training}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Selection -->
                        <RowDefinition Height="Auto"/> <!-- Record Button & Progress -->
                        <RowDefinition Height="*"/>    <!-- Stats & Management -->
                    </Grid.RowDefinitions>

                    <!-- STEP 1: SELECT ACTION TO TRAIN -->
                    <Border Grid.Row="0" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Step1_Title}" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,10"/>

                            <WrapPanel x:Name="PanelActionButtons">
                                <RadioButton x:Name="RbPlayPause" Content="{DynamicResource Train_PlayPause}" IsChecked="True" Foreground="#ECEFF1" FontSize="13" Margin="0,0,16,8"/>
                                <RadioButton x:Name="RbNext" Content="{DynamicResource Train_Next}" Foreground="#ECEFF1" FontSize="13" Margin="0,0,16,8"/>
                                <RadioButton x:Name="RbPrev" Content="{DynamicResource Train_Prev}" Foreground="#ECEFF1" FontSize="13" Margin="0,0,16,8"/>
                                <RadioButton x:Name="RbVolUp" Content="{DynamicResource Train_VolUp}" Foreground="#ECEFF1" FontSize="13" Margin="0,0,16,8"/>
                                <RadioButton x:Name="RbVolDown" Content="{DynamicResource Train_VolDown}" Foreground="#ECEFF1" FontSize="13" Margin="0,0,16,8"/>
                                <RadioButton x:Name="RbIdle" Content="{DynamicResource Train_Idle}" Foreground="#FFD54F" FontWeight="Bold" FontSize="13" Margin="0,0,16,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- STEP 2: RECORD BUTTON & LIVE RECORDING -->
                    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Step2_DurationLabel}" Foreground="#B0BEC5" VerticalAlignment="Center" FontSize="13"/>
                                    <RadioButton x:Name="RbDur5" Content="{DynamicResource Step2_Dur5}" Foreground="#ECEFF1" Margin="8,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RbDur7" Content="{DynamicResource Step2_Dur7}" IsChecked="True" Foreground="#00E5FF" FontWeight="Bold" Margin="8,0" VerticalAlignment="Center"/>
                                    <RadioButton x:Name="RbDur10" Content="{DynamicResource Step2_Dur10}" Foreground="#ECEFF1" Margin="8,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Step2_TipReps}" HorizontalAlignment="Right" Foreground="#FFD54F" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnRecord" Height="65" Background="#D32F2F" Foreground="#FFFFFF"
                                        FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" Click="BtnRecord_Click">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Step2_BtnRecord}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        <TextBlock Text="{DynamicResource Step2_BtnRecordSub}" FontSize="10" Foreground="#FFCDD2" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock x:Name="TxtRecordStatus" Text="{DynamicResource Step2_StatusInitial}" FontSize="13" Foreground="#ECEFF1" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="TxtRecordCountdown" Text="{DynamicResource Step2_StatusReady}" HorizontalAlignment="Right" FontSize="14" Foreground="#00E5FF" FontWeight="Bold"/>
                                    </Grid>
                                    <ProgressBar x:Name="PbRecordProgress" Height="10" Style="{StaticResource SensorBar}" Foreground="#D32F2F" Maximum="100" Value="0"/>
                                    <TextBlock x:Name="TxtLastRecordedInfo" Text="{DynamicResource Step2_LastRecordNone}" FontSize="11" Foreground="#90A4AE" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- STEP 3: STATS & MODEL COMPILATION -->
                    <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Step3_Title}" FontSize="13" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="BtnTrainModel" Content="{DynamicResource Step3_BtnTrain}" Height="36" Padding="14,0"
                                            Background="#00C853" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                                            Click="BtnTrainModel_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnClearRecordings" Content="{DynamicResource Step3_BtnClear}" Height="36" Padding="10,0"
                                            Background="#37474F" Foreground="#ECEFF1" BorderThickness="0" Cursor="Hand"
                                            Click="BtnClearRecordings_Click"/>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="GridTrainingStats" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#161820" BorderThickness="0" HeadersVisibility="Column"
                                      GridLinesVisibility="None" RowBackground="Transparent" AlternatingRowBackground="#1B1E26" Foreground="#ECEFF1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Step3_Col_Action}" Binding="{Binding ActionName}" Width="200" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="{DynamicResource Step3_Col_Samples}" Binding="{Binding SampleCount}" Width="160"/>
                                    <DataGridTextColumn Header="{DynamicResource Step3_Col_PeakG}" Binding="{Binding PeakGFormatted}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Step3_Col_PeakGyro}" Binding="{Binding PeakGyroFormatted}" Width="180"/>
                                    <DataGridTextColumn Header="{DynamicResource Step3_Col_Status}" Binding="{Binding Status}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#212530" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                                <TextBlock Text="{DynamicResource Step3_Tip}"
                                           Foreground="#80CBC4" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
